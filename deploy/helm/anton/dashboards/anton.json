   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (source) (rate(anton_chat_tokens_total[5m]))",
     "legendFormat": "{{source}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
