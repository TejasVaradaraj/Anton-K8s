   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 20
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
